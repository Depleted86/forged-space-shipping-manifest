{
  "manifest_version": 3,
  "name": "Forged Space Calculator",
  "version": "3.0",
  "description": "Mining/refining/harvesting/assembly planner for Forged Space, with a live To-Mine popup and inventory sync built into the extension - no separate desktop app required.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://forgedspace.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://forgedspace.com/*"],
      "js": ["js/browser-compat.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Forged Space Calculator",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{29b5945d-3b6b-4b10-bfee-047cdfb61d59}",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
